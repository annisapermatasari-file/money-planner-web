rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every document lives under users/{uid}/... — a signed-in user may
    // read and write only their own subtree, at any depth.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
